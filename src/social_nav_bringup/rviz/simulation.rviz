Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: false
      Cell Size: 1
      Plane Cell Count: 30
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: false
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: false
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 25; 160; 60
      Line Style: Lines
      Line Width: 0.03
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot 4
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: People & robot
      Enabled: true
      Namespaces:
        heading: true
        labels: true
        people: true
        personal_space: true
        robot: true
        robot_task: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /human_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Leg tracker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /leg_tracker/markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: SFM forces
      Enabled: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sfm_forces
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: Robot goal
      Enabled: true
      Axes Length: 0.6
      Axes Radius: 0.05
      Color: 25; 25; 25
      Head Length: 0.25
      Head Radius: 0.15
      Shaft Length: 0.6
      Shaft Radius: 0.06
      Shape: Arrow
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /level/robot_goal
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 45
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Value: false
      Invert Z Axis: false
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 860
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: true
